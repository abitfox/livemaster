# ===== Neon Postgres（Vercel 集成会自动注入同名变量）=====
# 应用运行用（pooler 地址；Serverless 环境必用）
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DDL/迁移用（非池化）
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ===== 会话签名密钥 =====
# 生成方式：openssl rand -base64 32
AUTH_SECRET=

# ===== LLM（供应商无关，兼容任何 OpenAI Chat Completions 风格 API）=====
# 未配置 Key 时系统自动进入「模板降级模式」，Bot 弹幕走本地模板，仍可完整演示
# 优先读 LLM_*，未设置时回退旧 GLM_* 变量。切换供应商只需改这一组变量。

# —— DeepSeek 示例（当前默认）——
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 重任务模型（复盘报告）
LLM_MODEL=deepseek-flash
# 高频轻量模型（建场观众群 / tick 弹幕），未设置时按 BASE_URL 自动推断
LLM_FAST_MODEL=deepseek-flash
LLM_TICK_MODEL=deepseek-flash

# —— 智谱 GLM 示例（要切回时替换上面的值）——
# 注意：glm-5.3-flash 强制思考、无法关闭，单次 25~90s，勿用于高频调用；
# 高频请用无思考的 glm-4-air。thinking 参数只对智谱发送，其他供应商自动跳过。
# LLM_API_KEY=<智谱 Key>
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.3-flash
# LLM_FAST_MODEL=glm-4-air
# LLM_TICK_MODEL=glm-4-air

