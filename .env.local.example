# ===== Neon Postgres（Vercel 集成会自动注入同名变量）=====
# 应用运行用（pooler 地址；Serverless 环境必用）
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DDL/迁移用（非池化）
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ===== 会话签名密钥 =====
# 生成方式：openssl rand -base64 32
AUTH_SECRET=

# ===== 智谱 GLM =====
# 未配置时系统自动进入「模板降级模式」，Bot 弹幕走本地模板，仍可完整演示
GLM_API_KEY=
# 重任务模型（复盘报告）：glm-5.3-flash 强制思考、无法关闭，单次 25~90s，勿用于高频调用
GLM_MODEL=glm-5.3-flash
# 高频轻量模型（建场观众群 / tick 弹幕）：无思考模式，实测 ~2s
GLM_FAST_MODEL=glm-4-air
GLM_TICK_MODEL=glm-4-air
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
